{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai24kmagic",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    "EMAIL_FROM": "noreply@24kmagicai.com",
    // To enable Rybbit, set this to your Rybbit API URL (e.g. https://rybbit.example.com/api) and add analytics.rybbit to site.config.ts.
    "RYBBIT_UPSTREAM": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai24kmagic",
      "database_id": "<set after wrangler d1 create>",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "OUTPUTS", "bucket_name": "ai24kmagic-outputs" }],
  "send_email": [{ "name": "EMAIL" }],
  "workflows": [
    {
      "name": "ai24kmagic-generation",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow"
    }
  ],
  // Effect compose container: ffmpeg image in packages/jobs/compose. Instance type is set in start() in server.ts.
  "containers": [
    {
      "class_name": "ComposeContainer",
      "scheduling_policy": "durable_object",
      "images": { "compose": { "dockerfile": "../../packages/jobs/compose/Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "COMPOSE", "class_name": "ComposeContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ComposeContainer"] }],
  // Local dev neither builds nor runs the container (no Docker). With UPSTREAM_MOCK=1 the mock composer is used.
  "dev": { "enable_containers": false }
}
